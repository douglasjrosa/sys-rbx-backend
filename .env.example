HOST=0.0.0.0
PORT=1339
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Database - Local dev (XAMPP): use these when running npm run develop
# Docker: docker-compose overrides with container db (strapi_user)
DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=strapi
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_SSL=false

# Pixtrela webhook — pedido lifecycle pushes tasks when Bpedido is set.
# PIXTRELA_WEBHOOK_SECRET must match CRM_WEBHOOK_SECRET on Pixtrela Next.
# Requires Node 18+ for native fetch.
PIXTRELA_WEBHOOK_URL=http://localhost:3000/api/webhooks/crm-pedido
PIXTRELA_WEBHOOK_SECRET=replace-with-shared-hmac-secret
